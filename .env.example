# Google Gemini API key — get free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Pinecone API key — get free at https://app.pinecone.io
PINECONE_API_KEY=

# Name of the Pinecone index to use (create it first — see README)
PINECONE_INDEX_NAME=rag

# Models (free-tier friendly defaults — change if needed)
EMBEDDING_MODEL=models/gemini-embedding-001
CHAT_MODEL=gemini-3.5-flash
